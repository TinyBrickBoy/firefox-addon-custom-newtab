{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.0.1",
  "description": "__MSG_extensionDescription__",
  "author": "TinyBrickBoy",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "custom-newtab-url@tinybrickboy",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage", "declarativeNetRequest", "cookies", "sessions", "scripting"],
  "optional_host_permissions": ["*://*/*"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "scripts": ["settings.js", "background.js"]
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  }
}
